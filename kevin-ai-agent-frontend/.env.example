# 复制为 .env.production-api.local 可覆盖生产 API 地址（不会被 git 跟踪）

# 本地后端代理地址
VITE_API_PROXY_TARGET=http://localhost:8125

# --- 本地开发（npm run dev）---
# VITE_API_BASE_URL=/api
# VITE_APP_API_ENV=local

# --- 本地开发连接生产后端（npm run dev:prod）---
# VITE_API_BASE_URL=https://your-production-domain.com/api
# VITE_APP_API_ENV=production

# --- 生产构建（npm run build）---
# 前后端同域：VITE_API_BASE_URL=/api
# 前后端分离：VITE_API_BASE_URL=https://your-production-domain.com/api
# VITE_APP_API_ENV=production
